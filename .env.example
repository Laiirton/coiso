# 🤖 WhatsApp Lottie Bot - Environment Configuration
# Copie este arquivo para .env e ajuste as variáveis

# ============ Bot Identity ============
BOT_NAME="WhatsApp Lottie Bot"
SESSION_FOLDER="auth_info_baileys"
PREFIX="!"

# ============ Logging ============
NODE_ENV=production
LOG_LEVEL=info  # debug | info | warn | error | fatal

# ============ WhatsApp Connection ============
# Deixe em branco para usar a versão automática mais recente
# Versão fixa (recomendada para produção): [2,3000,1033893291]
WA_VERSION="[2,3000,1033893291]"

# Browser simulation (evita bloqueios)
BROWSER='["Chrome","Windows","110.0.5481.177"]'

# Timeouts (milliseconds)
CONNECT_TIMEOUT=60000
RECONNECT_DELAY=15000
MAX_RETRIES=5

# ============ Paths ============
TMP_DIR="tmp"
LOGS_DIR="logs"

# ============ Security ============
# Números de telefone autorizados (formato: 5511999999999, sem +)
# Separe por vírgula. Deixe vazio para permitir todos.
ADMIN_NUMBERS=""

# ============ Features ============
ENABLE_MEDIA=true
AUTO_DOWNLOAD_MEDIA=false
