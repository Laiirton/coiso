{
  "name": "whatsapp-sticker-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Bot do WhatsApp para converter imagens e videos em figurinhas com WPPConnect.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
